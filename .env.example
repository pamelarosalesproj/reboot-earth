# =============================================================================
# RebootEarth - Configurações de Ambiente (.env)
# =============================================================================

# 1. Credenciais do MapBiomas Alerta (API GraphQL oficial)
# Documentação: https://docs.api.alerta.mapbiomas.org/pt-BR/exemplos-de-consulta/sign-in
MAPBIOMAS_EMAIL=seu_email@exemplo.com
MAPBIOMAS_PASSWORD=sua_senha_aqui
MAPBIOMAS_API_URL=https://plataforma.alerta.mapbiomas.org/api/v2/graphql
MAPBIOMAS_TIMEOUT_S=20.0

# 2. Configurações do Agente de IA (Consultor ESG)
# Suporta Google Gemini (API compatível OpenAI), OpenAI ou proxies locais
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=sua_chave_api_do_llm_aqui
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_S=30.0

# 3. Backend & Segurança
# Em produção com HTTPS, altere COOKIE_SECURE para True
COOKIE_SECURE=False
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_SEARCH_LIMIT_PER_HOUR=30

